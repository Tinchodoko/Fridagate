# Configuración de ktlint para Fridagate (usada solo por el workflow de análisis).
root = true

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120
# Los Composables se nombran con mayúscula inicial (convención de Compose).
ktlint_function_naming_ignore_when_annotated_with = Composable
